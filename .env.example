DB_HOST=localhost
DB_PORT=5432
DB_NAME=stemhubdev
DB_USER=stemhub_app
DB_PASSWORD=CAMBIAR_PASSWORD
APP_PORT=8080

# Auth (Supabase) — por defecto apunta al stack local levantado con la
# Supabase CLI (`supabase start`, ver supabase/README.md).
# Debe ser "127.0.0.1", no "localhost": la Supabase CLI siempre firma el
# claim "iss" del token como http://127.0.0.1:54321/auth/v1 (valor fijo,
# no configurable), y el Backend exige que coincida exactamente.
# Para usar un proyecto de Supabase Cloud en su lugar, reemplazar por:
#   SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
#   SUPABASE_JWKS_BASE_URL=   (dejar vacía)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_AUDIENCE=authenticated

# Solo con el Backend dockerizado + Supabase CLI local: "127.0.0.1" dentro
# de un contenedor no es el host, así que el JWKS se descarga por la red
# Docker que crea la CLI (servicio "kong"), aunque el issuer siga siendo
# 127.0.0.1 (ver supabase/README.md). Dejar vacía si se usa Supabase Cloud.
SUPABASE_JWKS_BASE_URL=http://kong:8000

# CORS: orígenes desde los que el navegador puede llamar a esta API. El
# frontend (Vite) corre en un origen distinto al backend en dev. Separar
# con comas si hay más de uno (ej. preview de Vite en otro puerto).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP para mails transaccionales enviados directamente por el backend Go
# (invitaciones a proyecto). Es un envío separado del auth.email.smtp de
# supabase/config.toml — GoTrue nunca ve ni dispara estos mails, aunque en
# producción comparten proveedor/credencial (SendGrid). En dev local, para
# no pegarle a SendGrid real, apuntar a Inbucket (ver supabase/config.toml,
# sección [local_smtp]): SMTP_HOST=127.0.0.1, SMTP_PORT=54325 (o el puerto
# que exponga la CLI), sin usuario/password.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CAMBIAR_SENDGRID_API_KEY
SMTP_REMITENTE=StemHub <no-reply@stemhub.app>

# Base URL pública del frontend, usada para construir el link de
# invitación (ej. http://localhost:5173/invitaciones/<token>).
FRONTEND_BASE_URL=http://localhost:5173

# Días de vigencia de una invitación a proyecto antes de vencer.
INVITACION_DIAS_VENCIMIENTO=7
# Copiar a supabase/.env (ignorado por git). La Supabase CLI lo lee al
# correr "supabase start" y reemplaza los env(...) de config.toml.
#
# Cliente OAuth "Aplicación web" de Google Cloud Console, con la URI de
# redirección autorizada http://127.0.0.1:54321/auth/v1/callback
# (ver docs/login-google.md del repo stemhub-system).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
